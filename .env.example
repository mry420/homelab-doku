# Vorlage für lokale Werte. Kopieren nach .env und dort ausfüllen:
#   cp .env.example .env
# Die echte .env ist per .gitignore ausgeschlossen.

# --- Netz ---------------------------------------------------------------
DOMAIN=<DOMAIN>

# --- Cloudflare ---------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=<CLOUDFLARE_TUNNEL_TOKEN>

# --- Tailscale ----------------------------------------------------------
TAILSCALE_AUTHKEY=<TAILSCALE_AUTHKEY>

# --- Hetzner-VPS --------------------------------------------------------
VPS_PUBLIC_IP=<VPS_PUBLIC_IP>
VPS_SSH_USER=<VPS_SSH_USER>

# --- RustDesk -----------------------------------------------------------
RUSTDESK_PUBLIC_KEY=<RUSTDESK_PUBLIC_KEY>
